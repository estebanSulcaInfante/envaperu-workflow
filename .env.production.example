FLASK_ENV=production
# Conexión PostgreSQL server-side. En Render usar el Supavisor de sesión de
# Supabase con SSL; guardar el valor como secreto y no incorporarlo al repositorio.
DATABASE_URL=postgresql://usuario:password@host:5432/postgres?sslmode=require

# JWT y Seguridad
SECRET_KEY=tu_super_secreto_aqui
JWT_SECRET_KEY=tu_jwt_secret_aqui

# API Keys de Servicios Externos
GEMINI_API_KEY=tu_api_key_de_gemini

# Imágenes de catálogos en un bucket privado de Supabase Storage.
CATALOG_IMAGE_STORAGE=supabase_s3
# Mantener true durante el primer corte para disponer de reversa a bytea.
CATALOG_IMAGE_KEEP_DATABASE_COPY=true
SUPABASE_S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=guardar_como_secreto_en_render
SUPABASE_S3_SECRET_ACCESS_KEY=guardar_como_secreto_en_render
SUPABASE_STORAGE_BUCKET=catalog-images

# Dominio exacto del frontend desplegado, sin barra final.
ALLOWED_ORIGINS=https://frontend.example.com

# Identidad de usuarios. local_actor se reserva para desarrollo; el despliegue
# definitivo usa supabase y valida JWT ES256 mediante el JWKS público.
SCM_AUTH_MODE=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
