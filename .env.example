# Gemini API Key for OCR
GEMINI_API_KEY=your_api_key_here

# Desarrollo local: las imágenes permanecen en PostgreSQL.
CATALOG_IMAGE_STORAGE=database
CATALOG_IMAGE_KEEP_DATABASE_COPY=true

# Orígenes permitidos, separados por coma. En producción no usar *.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Acceso personal OpenClaw: opt-in independiente del asistente anterior.
SCM_PERSONAL_AGENT_ACCESS_ENABLED=false
SCM_PERSONAL_AGENT_BRIDGE_ORIGIN=
# Dos secretos distintos de al menos 32 bytes, suministrados por el entorno.
SCM_PERSONAL_AGENT_ASSERTION_SECRET=
SCM_PERSONAL_AGENT_SERVICE_SECRET=
SCM_PERSONAL_AGENT_MAX_SESSION_SECONDS=3600
