# Supply secrets through the deployment secret store, never this file.
SCM_PERSONAL_AGENT_SERVICE_SECRET=replace-with-a-random-32-byte-secret
SCM_API_URL=https://scm-api.example.invalid/api
SCM_ALLOWED_ORIGIN=https://agent.example.invalid/
SCM_SCM_ORIGIN=https://scm.example.invalid/
# Run the bridge in the native gateway network namespace, or use verified TLS
# for a separately addressed native host. Plain HTTP/WS is loopback-only.
SCM_NATIVE_HTTP_ORIGIN=http://127.0.0.1:18789/
SCM_NATIVE_WS_URL=ws://127.0.0.1:18789
SCM_NATIVE_TRUSTED_HOSTS=
# Auto-provision is the default; manifest mode is a compatibility option.
SCM_NATIVE_PROVISION_MODE=auto
SCM_NATIVE_TEMPLATE_AGENT_ID=scm-personal
SCM_NATIVE_WORKSPACE_ROOT=/state/scm-personal/workspaces
SCM_NATIVE_SHARED_CORPUS=/state/scm-personal/corpus
SCM_NATIVE_STATE_ROOT=/state
# SCM_NATIVE_MANIFEST=/run/secrets/personal-agents.json
SCM_NATIVE_ADMIN_PASSWORD_FILE=/run/secrets/openclaw-admin-password
SCM_BRIDGE_DB_PATH=/var/lib/scm-openclaw-bridge/bridge.sqlite
SCM_PERSONAL_AGENT_MAX_SESSION_SECONDS=3600
SCM_PERSONAL_AGENT_MAX_IDLE_SECONDS=900
SCM_BRIDGE_MAX_DOWNLOAD_BYTES=16777216
SCM_BRIDGE_MAX_INLINE_BYTES=8388608
